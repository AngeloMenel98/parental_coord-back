# Environment files
#
# Two files, one per environment. `ENV_FILE` selects which one a command reads
# (ConfigModule, data-source, seed and storage scripts all honour it):
#
#   .env        -> LOCAL dev. docker compose postgres + redis. Never baked into
#                  a deployment, never points at the cloud.
#   .env.prod   -> PRODUCTION. Supabase Cloud Postgres (Supavisor pooler) and
#                  the production storage bucket.
#
# Neither file is committed (`.env*` is gitignored, `.env.example` is the only
# tracked one). Prod operations are explicit:
#
#   pnpm typeorm:prod        # migration:run against .env.prod
#   pnpm seed:admin:prod     # seed against .env.prod
#   pnpm storage:init:prod   # bucket bootstrap against .env.prod
#
# Postgres connection
#
# Local dev (docker compose): keep the defaults below.
#
# Supabase Cloud (goes in .env.prod):
#   DB_HOST=<region>.pooler.supabase.com
#   DB_PORT=5432                      # Supavisor SESSION pooler: runtime + DDL
#   DB_USER=postgres.<project-ref>
#   DB_NAME=postgres
#   DB_SSL=true
# Do NOT use 6543 (transaction pooler): TypeORM prepared statements break.
# The direct host db.<project-ref>.supabase.co is IPv6-only, unreachable on
# IPv4-only machines — the session pooler is the migration path there.
DB_HOST=localhost
DB_PORT=5432
DB_USER=parental
DB_PASSWORD=parental_secret
DB_NAME=parental_coordination
# 'true' for managed Postgres (Supabase/Neon) — enables SSL
DB_SSL=false

# JWT
JWT_SECRET=change-me-in-production-use-a-real-secret
JWT_EXPIRES_IN=24h

# Redis / timers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 'true' for managed Redis requiring TLS
REDIS_TLS=false
# Response window (hours) before an assigned activity becomes overdue
RESPONSE_TIMEOUT_HOURS=36

# Webhooks (all optional — defaults shown)
# Payload-only API version constant (NOT URL versioning)
WEBHOOK_API_VERSION=2026-10-01
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_POLL_INTERVAL_MS=2000
WEBHOOK_RECONCILE_INTERVAL_MS=300000
WEBHOOK_MAX_PER_BOND=10
WEBHOOK_ENDPOINT_CONCURRENCY=5
WEBHOOK_ROTATION_GRACE_HOURS=24
WEBHOOK_AUTO_DISABLE_DAYS=5
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# AES-256-GCM master key (base64, 32 bytes). Required in prod; lazy error in dev.
WEBHOOK_SECRET_MASTER_KEY=

# Realtime (WS signal channel — design #1471)
# Endpoint path of the realtime WebSocket gateway (does NOT go through the `api` prefix)
WS_PATH=/realtime
# 'false' → the worker does not publish to the realtime:activities Redis channel
REALTIME_PUBLISH_ENABLED=true

# Notifications (all optional — defaults shown)
# Retention window for notifications; purge runs daily
NOTIFICATIONS_RETENTION_DAYS=30
NOTIFICATIONS_RETENTION_INTERVAL_MS=86400000
# 'false' → worker outbox→notification fan-out is disabled (emergency brake:
# events are still dispatched and webhooks delivered, but no notifications are written)
NOTIFICATIONS_FANOUT_ENABLED=true

# App
PORT=3000
NODE_ENV=development
# Comma-separated CORS origins (defaults to '*' if unset)
CORS_ORIGINS=

# Activity attachments storage (Supabase Cloud)
#
# One Supabase project owns Postgres and Storage. Bucket setup is automated:
#
#   pnpm storage:init          # .env  -> bucket activity-attachments-dev
#   pnpm storage:init:prod     # .env.prod -> bucket activity-attachments
#
# Dev and prod share the project (and therefore the service-role key), but not
# the bucket: local tests must never write into the production bucket. Full
# isolation needs a second Supabase project.
#
# Keys live in Project Settings > API. SUPABASE_SERVICE_ROLE_KEY is server-side
# only: anyone holding it bypasses every storage policy. Buckets are private and
# the API hands out short-lived signed URLs.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET_ACTIVITY_ATTACHMENTS=activity-attachments-dev
ATTACHMENTS_MAX_SIZE_BYTES=10485760
