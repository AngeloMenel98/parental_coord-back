# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=parental
DB_PASSWORD=parental_secret
DB_NAME=parental_coordination
# 'true' for managed Postgres (Supabase/Neon) — enables SSL
DB_SSL=false

# JWT
JWT_SECRET=change-me-in-production-use-a-real-secret
JWT_EXPIRES_IN=24h

# App
PORT=3000
NODE_ENV=development
# Comma-separated CORS origins (defaults to '*' if unset)
CORS_ORIGINS=
