# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=parental
DB_PASSWORD=parental_secret
DB_NAME=parental_coordination
# 'true' for managed Postgres (Supabase/Neon) — enables SSL
DB_SSL=false

# JWT
JWT_SECRET=change-me-in-production-use-a-real-secret
JWT_EXPIRES_IN=24h

# Redis / timers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 'true' for managed Redis requiring TLS
REDIS_TLS=false
# Response window (hours) before an assigned activity becomes overdue
RESPONSE_TIMEOUT_HOURS=36

# Webhooks (all optional — defaults shown)
# Payload-only API version constant (NOT URL versioning)
WEBHOOK_API_VERSION=2026-10-01
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_POLL_INTERVAL_MS=2000
WEBHOOK_RECONCILE_INTERVAL_MS=300000
WEBHOOK_MAX_PER_BOND=10
WEBHOOK_ENDPOINT_CONCURRENCY=5
WEBHOOK_ROTATION_GRACE_HOURS=24
WEBHOOK_AUTO_DISABLE_DAYS=5
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# AES-256-GCM master key (base64, 32 bytes). Required in prod; lazy error in dev.
WEBHOOK_SECRET_MASTER_KEY=

# App
PORT=3000
NODE_ENV=development
# Comma-separated CORS origins (defaults to '*' if unset)
CORS_ORIGINS=
